#!/usr/bin/env bash
# Start Threat Arena in your browser.
#
# Usage: ./run
#
# The first run creates a private Python environment in .venv and installs
# the packages in requirements.txt. Stop the app with Ctrl+C.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
VENV="$ROOT/.venv"

if ! command -v python3 >/dev/null 2>&1; then
  echo "Python 3 is needed. On a Mac: brew install python" >&2
  exit 1
fi

if [[ ! -x "$VENV/bin/streamlit" ]]; then
  echo "==> First run: installing into .venv (about a minute)"
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q --upgrade pip
  "$VENV/bin/pip" install -q -r "$ROOT/requirements.txt"
fi

echo "==> Starting Threat Arena. Stop it with Ctrl+C."
cd "$ROOT"
exec "$VENV/bin/streamlit" run app.py --server.address localhost --browser.gatherUsageStats false "$@"
